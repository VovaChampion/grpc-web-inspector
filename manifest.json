{
  "manifest_version": 3,
  "name": "gRPC-Web Inspector",
  "version": "0.1.0",
  "description": "Byte-accurate gRPC-Web traffic inspector built on the Chrome DevTools Protocol, for reliable frame decoding on streaming and binary responses.",
  "permissions": ["debugger", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html",
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
